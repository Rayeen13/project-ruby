{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Ruby",
  "version": "0.5.0",
  "identifier": "io.github.rayeen13.projectruby",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required",
        "title": "Prismy Studio — Project Ruby",
        "width": 1120,
        "height": 820,
        "minWidth": 640,
        "minHeight": 600,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "capabilities": [
        "desktop-viewer"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' blob: ipc: http://ipc.localhost http://127.0.0.1:8081; object-src 'none'; frame-src 'none'; base-uri 'self'; media-src 'self' blob: data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Entertainment",
    "shortDescription": "Expressive desktop companion prototype",
    "longDescription": "Expressive Companion studio with local LLM setup, separate conversation, optional internet answers, owner memory and downloadable VoiceM speech.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
