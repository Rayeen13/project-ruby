{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-viewer",
  "description": "Local viewer may control only its own companion window and receive host status; no filesystem, shell or OS input commands.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "allow-desktop-action",
    "allow-desktop-status",
    "allow-desktop-move",
    "allow-desktop-smoke-report",
    "allow-desktop-smoke-checkpoint",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
