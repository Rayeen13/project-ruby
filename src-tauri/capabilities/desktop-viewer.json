{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-viewer",
  "description": "Companion window, chat on fixed loopback endpoint, and a managed checksum-pinned AI pack; no arbitrary URLs, executable paths, shell or OS input commands.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "allow-desktop-action",
    "allow-desktop-status",
    "allow-desktop-move",
    "allow-desktop-smoke-report",
    "allow-desktop-smoke-checkpoint",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-local-ai-models",
    "allow-local-ai-chat",
    "allow-local-ai-cancel",
    "allow-ai-pack-status",
    "allow-ai-pack-run",
    "allow-ai-pack-stop"
  ]
}
