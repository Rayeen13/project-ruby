{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-viewer",
  "description": "Companion may control its own window and chat with one fixed loopback AI server; no filesystem, shell, arbitrary URLs or OS input commands.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "allow-desktop-action",
    "allow-desktop-status",
    "allow-desktop-move",
    "allow-desktop-smoke-report",
    "allow-desktop-smoke-checkpoint",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-local-ai-models",
    "allow-local-ai-chat",
    "allow-local-ai-cancel"
  ]
}
