{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-viewer",
  "description": "Companion host, fixed loopback LLM engines, explicit search, HTTPS browser links and checksum-pinned VoiceM downloads. No unrestricted shell or OS input.",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "allow-desktop-action",
    "allow-desktop-status",
    "allow-desktop-move",
    "allow-desktop-smoke-report",
    "allow-desktop-smoke-checkpoint",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-local-ai-models",
    "allow-local-ai-chat",
    "allow-local-ai-cancel",
    "allow-ai-pack-status",
    "allow-ai-pack-run",
    "allow-ai-pack-stop",
    "allow-internet-search",
    "allow-open-web-url",
    "allow-voice-pack-status",
    "allow-voice-pack-download",
    "allow-voice-synthesize",
    "allow-voice-stop",
    "allow-desktop-body"
  ]
}
